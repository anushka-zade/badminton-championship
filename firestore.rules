rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "zadejanushka@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isValidTeamName(teamId) {
      return teamId in ["T1", "T2", "T3", "T4", "T5", "T6"]
        && request.resource.data.keys().hasAll(["name", "updatedAt"])
        && request.resource.data.keys().hasOnly(["name", "updatedAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.name.matches(".*\\S.*")
        && request.resource.data.updatedAt is timestamp;
    }

    match /tournaments/friends-badminton {
      // Everyone can view tournament scores. Only the verified admin can write them.
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Lock down the retired public suggestion/approval queue.
      match /nameRequests/{requestId} {
        allow read, write: if false;
      }

      // Public users may update only a validated team display name.
      // This collection is separate from the admin-only score document.
      match /teamNames/{teamId} {
        allow read: if true;
        allow create, update: if isValidTeamName(teamId);
        allow delete: if isAdmin();
      }
    }

    // Any other Firestore path is denied by default.
  }
}
