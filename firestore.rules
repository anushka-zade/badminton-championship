rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "zadejanushka@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /tournaments/friends-badminton {
      // Public read-only scoreboard.
      allow read: if true;

      // Only the verified admin can create, edit or delete official tournament data.
      allow create, update, delete: if isAdmin();

      match /nameRequests/{requestId} {
        // Only the admin can view submitted name requests.
        allow read: if isAdmin();

        // Public can submit a request, but cannot change official team names or scores.
        allow create: if request.resource.data.keys().hasAll([
            "teamId", "suggestedName", "requesterName", "createdAt"
          ])
          && request.resource.data.keys().hasOnly([
            "teamId", "suggestedName", "requesterName", "createdAt"
          ])
          && request.resource.data.teamId is string
          && request.resource.data.teamId in ["T1", "T2", "T3", "T4", "T5", "T6"]
          && request.resource.data.suggestedName is string
          && request.resource.data.suggestedName.size() > 0
          && request.resource.data.suggestedName.size() <= 40
          && request.resource.data.requesterName is string
          && request.resource.data.requesterName.size() <= 40
          && request.resource.data.createdAt is timestamp;

        // Only the verified admin can approve or reject requests.
        allow update, delete: if isAdmin();
      }
    }
  }
}